{
  "name": "gonax-backend",
  "version": "1.0.0",
  "description": "GoNax - Species-Specific Carbon Intelligence REST API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "tsx src/database/migrate.ts",
    "seed": "tsx src/database/seeds/seed.ts",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "keywords": ["carbon", "biomass", "forestry", "allometry", "climate-tech", "scientific-ai"],
  "author": "GoNax Team",
  "license": "Apache-2.0",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
