# GoNax Backend Environment Configuration

PORT=5000
NODE_ENV=development

# Database Configuration
# Defaults to local PostgreSQL. If PostgreSQL is unavailable or unauthenticated,
# GoNax automatically uses persistent SQLite storage for instantaneous zero-friction development.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gonax_db
# Set to 'sqlite' or 'postgres' or leave blank for auto-detection
DATABASE_DRIVER=auto
SQLITE_DB_PATH=./data/gonax_local.db

# Explanation Layer (Optional: leave blank for deterministic scientific reasoning engine)
GEMINI_API_KEY=
LLM_MODEL=gemini-1.5-flash
