# GoNax Backend — Development Environment Template

PORT=5000
NODE_ENV=development

# Database Configuration
# Defaults to local PostgreSQL. If PostgreSQL is unavailable,
# GoNax automatically falls back to persistent local storage (data/gonax_local.json).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gonax_db
DATABASE_DRIVER=auto
DATA_RETENTION_DAYS=90

# Security Configuration
# In development, built-in dev secrets are used if left blank.
JWT_SECRET=gonax-dev-secret-key-change-in-production-min32chars!
JWT_EXPIRES_IN=7d
ADMIN_API_KEY=gonax-admin-dev-key-change-in-production!

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
MAX_UPLOAD_BYTES=5242880

# AI / Scientific Assistant (Optional: leave blank for deterministic scientific reasoning engine)
GEMINI_API_KEY=
LLM_MODEL=gemini-1.5-flash
LLM_TIMEOUT_MS=10000
