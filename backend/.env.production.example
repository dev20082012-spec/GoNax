# GoNax Backend — Production Deployment Environment Template
# IMPORTANT: Provide cryptographically random secrets for production deployment.

PORT=5000
NODE_ENV=production

# Database Configuration (Managed PostgreSQL instance e.g. AWS RDS, GCP Cloud SQL)
DATABASE_URL=postgresql://gonax_prod_user:REPLACE_WITH_STRONG_DB_PASSWORD@prod-db.internal:5432/gonax_prod
DATABASE_DRIVER=postgres
DATA_RETENTION_DAYS=180

# Security Configuration (Generate with: openssl rand -hex 32)
JWT_SECRET=REPLACE_WITH_MINIMUM_32_CHAR_CRYPTOGRAPHIC_KEY_RANDOM
JWT_EXPIRES_IN=7d
ADMIN_API_KEY=REPLACE_WITH_STRONG_RANDOM_ADMIN_KEY_MIN_16_CHARS

# CORS Allowed Origins (Strict origins only, NO wildcards!)
CORS_ALLOWED_ORIGINS=https://gonax.org,https://app.gonax.org

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
MAX_UPLOAD_BYTES=5242880

# AI / Scientific Assistant
GEMINI_API_KEY=REPLACE_WITH_HOSTED_GEMINI_API_KEY
LLM_MODEL=gemini-1.5-flash
LLM_TIMEOUT_MS=8000
